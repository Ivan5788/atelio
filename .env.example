# 複製成 .env 後填入。.env 已列入 .gitignore，請勿提交真實值。
# 全部留空也能在本機用 npm run dev 執行：資料改存在記憶體，開發模式會自動產生 appSecret。

# Nuxt appSecret：Session Cookie 由它衍生的金鑰加密。正式環境必填（建置不會自動產生）。
# 產生方式：openssl rand -base64 32
NUXT_APP_SECRET=

# Upstash Redis。也接受 Vercel Marketplace 自動注入的 KV_REST_API_URL／KV_REST_API_TOKEN。
# 留空時資料存在記憶體（重新啟動就清空），本機開發不需要帳號。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 網站正式網址，用於 canonical、sitemap、OG 圖片
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# 是否開放搜尋引擎索引。本站使用虛構資料，預設不開放（留空即可）；正式上線真實資料時才設為 true。
# 在建置時決定，修改後需要重新部署。
NUXT_PUBLIC_INDEXABLE=
