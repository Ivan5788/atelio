# 複製成 .env 後填入。.env 已列入 .gitignore，請勿提交真實值。
# 全部留空也能在本機執行：資料改存在記憶體，Session 密碼由 nuxt-auth-utils 自動產生。

# Session Cookie 加密金鑰，至少 32 字元（正式環境必填）
NUXT_SESSION_PASSWORD=

# Upstash Redis（Vercel Marketplace 安裝後會自動注入）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 網站正式網址，用於 canonical、sitemap、OG 圖片
NUXT_PUBLIC_SITE_URL=http://localhost:3000
